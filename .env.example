# Copie este arquivo para .env e preencha a chave do provedor desejado.
# Com as duas chaves preenchidas, o Google Gemini tem preferência.
# Sem nenhuma delas, a API não sobe e exibe um erro explicando o que falta.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
